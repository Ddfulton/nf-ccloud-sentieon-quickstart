/*
 * ===========================================================================
 *  REQUIRED INPUTS  —  edit the three values below. Nothing else in this
 *  repository needs to change.
 * ===========================================================================
 */

// 1. YOUR BUCKET
//    Where scratch space and results are written. You must be able to write
//    to it. Scratch gets large — budget several hundred GB for a WGS run.
params.bucket = 's3://CHANGE-ME'

// 2. YOUR REFERENCE GENOME
//    Full path to the FASTA.
//
//    NOTE: a FASTA on its own is NOT enough. This pipeline does not build the
//    index for you. These seven files must all sit in the same prefix:
//
//        your-reference.fna          your-reference.fna.pac
//        your-reference.fna.amb      your-reference.fna.sa
//        your-reference.fna.ann      your-reference.fna.fai
//        your-reference.fna.bwt
//
//    Run smoke.nf and it will tell you if any are missing.
params.fasta = 's3://CHANGE-ME/ref/your-reference.fna'

// 3. YOUR SAMPLES
//    A local CSV listing your FASTQs. Edit samplesheet.csv itself.
params.input = 'samplesheet.csv'


/*
 * ===========================================================================
 *  Everything below is Carolina Cloud infrastructure. Leave it alone.
 * ===========================================================================
 */

// Results go to object storage. Publishing s3 -> s3 is a server-side copy:
// fast, and it never pulls gigabytes down to the machine you launched from.
// Keep this on object storage — a local outdir makes Nextflow download every
// output through your launcher.
params.outdir = "${params.bucket}/results"
workDir       = "${params.bucket}/nextflow-scratch"

plugins {
    id 'nf-ccloud@1.0.0'
}

process {
    executor      = 'ccloud'
    container     = 'genomics-live-8:latest'    // single point of change on rebuild
    errorStrategy = 'retry'                     // workers can be preempted
    maxRetries    = 3
    disk          = { 100.GB * task.attempt }
}

ccloud {
    apiKey   = System.getenv('CCLOUD_API_KEY')
    endpoint = System.getenv('CCLOUD_ENDPOINT')
}

// Credentials come from the environment. On a Carolina Cloud head container
// they are already set for you.
aws {
    accessKey = System.getenv('AWS_ACCESS_KEY_ID')
    secretKey = System.getenv('AWS_SECRET_ACCESS_KEY')
    region    = System.getenv('AWS_REGION')
    client { endpoint = System.getenv('AWS_ENDPOINT_URL') }
}

// Exported inside the container, not on your machine. The Sentieon license
// ships in the image at /etc/sentieon/ccloud.lic — there is nothing to install.
env {
    SENTIEON_INSTALL_DIR = '/home/ccloud/sentieon-genomics-202503.02'
    SENTIEON_LICENSE     = '/etc/sentieon/ccloud.lic'
    SENTIEON_PYTHON      = '/usr/local/bin/python'
}
